@model List<UserRow>
@{
    ViewData["Title"] = "Users";
    var perm = (Permission)ViewBag.Permission;
}

<h2>Users</h2>

@if (perm.CanAdd)
{
    <a asp-action="Create" class="btn btn-primary mb-3">Add User</a>
}

<table class="table table-striped">
    <thead>
        <tr><th>Username</th><th>Full Name</th><th>Role</th><th>Active</th></tr>
    </thead>
    <tbody>
        @foreach (var u in Model)
        {
            <tr>
                <td>@u.Username</td>
                <td>@u.FullName</td>
                <td>@u.RoleName</td>
                <td>@(u.IsActive ? "Yes" : "No")</td>
            </tr>
        }
    </tbody>
</table>